{
  // Codespaces preview environment; see docs/how-to/codespaces-preview.md.
  "name": "VVMDM preview",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": { "cpus": 2 },
  // Install pinned tools from mise.toml once at creation.
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  // Start vv with sample media whenever the workspace opens.
  "postAttachCommand": "$HOME/.local/bin/mise exec -- task preview",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "VVMDM", "onAutoForward": "openBrowser" }
  },
  // Expose vv only through the proxy, not directly on port 18080.
  "otherPortsAttributes": { "onAutoForward": "ignore" }
}
