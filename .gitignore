# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# エージェントが作る一時 worktree。中身は別チェックアウトなので版管理しない。
.claude/worktrees/

# Dependencies and build output
node_modules/
dist/
# 版管理の根の build/ だけを除く。scripts/build は task build の実体なので、
# どの階層の build/ も除くと版管理から外れてしまう。
/build/
/bin/

# web/dist is the embed target for the Go binary. Only .gitkeep is version
# controlled, so that the directory exists and `go build ./...` works without a
# web build; every build artefact under web/dist stays out of version control.
# `task build` writes next to .gitkeep instead of replacing the directory, so the
# working tree stays clean whatever happens during the build.
!web/dist/
web/dist/*
!web/dist/.gitkeep

# npm run test の出力先。web/dist を汚さないために分けてある。
web/.vite-build-check/

# task が sources / generates の判定に使う作業領域
/.task/

# task test-web のビルド検証の出力先
/web/.vite-build-check/
/web/playwright-report/
/web/test-results/

# task dev が使う手元の作業場所
/media/
/.local/
/worktrees/

# Environment
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/

*.tsbuildinfo
