# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# エージェントが作る一時 worktree。中身は別チェックアウトなので版管理しない。
.claude/worktrees/

# Dependencies and build output
node_modules/
dist/
build/
/bin/

# web/dist is the embed target for the Go binary. The two placeholder files below
# are version controlled so that `go build ./...` works without a web build; every
# other build artefact under web/dist stays out of version control. `task build`
# restores the placeholder directory after embedding the production assets.
!web/dist/
web/dist/*
!web/dist/.gitkeep
!web/dist/index.html

# task test-web のビルド検証の出力先
/web/.vite-build-check/
/web/playwright-report/
/web/test-results/

# task dev が使う手元の作業場所
/media/
/.local/
/worktrees/

# Environment
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/

