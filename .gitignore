# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Agent worktrees are separate temporary checkouts.
.claude/worktrees/

# Dependencies and build output
node_modules/
dist/
# Anchor build/ at the root so scripts/build stays tracked.
/build/
/bin/

# Temporary go-winres icon and manifest objects used during Windows packaging.
/cmd/mdm/*.syso

# web/dist is the embed target for the Go binary. Only .gitkeep is version
# controlled, so that the directory exists and `go build ./...` works without a
# web build; every build artefact under web/dist stays out of version control.
# `task build` writes next to .gitkeep instead of replacing the directory, so the
# working tree stays clean whatever happens during the build.
!web/dist/
web/dist/*
!web/dist/.gitkeep

# Keep test output separate from web/dist.
web/.vite-build-check/

# VitePress cache; dist output is excluded above.
/docs-site/.vitepress/cache/

# Task source/output freshness state.
/.task/

# Web build-validation output.
/web/.vite-build-check/
/web/playwright-report/
/web/test-results/

# Local development state.
/media/
/.local/
/worktrees/

# Environment
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/

*.tsbuildinfo

# UI screenshots are not kept in the repository.
/docs/screenshots/

# Coverage, test reports and mutation results.
/reports/
