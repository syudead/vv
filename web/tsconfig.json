{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Node types let contrast tests read CSS from disk without adding a runtime dependency.
    "types": ["vite/client", "vitest/globals", "node"],

    // Match the @/ imports used by shadcn components and registry rules.
    "paths": { "@/*": ["./src/*"] },

    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "vite.config.ts", "tailwind.config.ts", "vitest.setup.ts"]
}
