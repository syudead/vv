{
  "name": "vv-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": "^11.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json && eslint . --max-warnings 0",
    "test": "npm run build:check && vitest run",
    "build:check": "vite build --outDir .vite-build-check --emptyOutDir",
    "test:unit": "vitest run",
    "test:e2e": "node e2e/run-e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "video.js": "^8.24.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.39.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
